  "strings": [
    {
      "key": "story_opponent_001",
      "ko": "훈련병 강민재",
      "en": "Recruit Kang Min-jae"
    },
    {
      "key": "story_stage_desc_001",
      "ko": "프로 출신 입대자라는 소문을 듣고 동기가 도전한다.",
      "en": "A fellow recruit challenges you after hearing you were a pro."
    },
    {
      "key": "story_opponent_002",
      "ko": "이병 문시온",
      "en": "Pvt. Moon Si-on"
    },
    {
      "key": "story_stage_desc_002",
      "ko": "훈련을 마치고 이병이 된 당신. 부대에도 프로 소문이 퍼졌다.",
      "en": "Training is over. Word of your pro career spreads through the unit."
    },
    {
      "key": "story_002_intro",
      "ko": "잠깐만, 진짜 프로랑 두는 거야?",
      "en": "Wait, am I really playing a pro?"
    },
    {
      "key": "story_002_win",
      "ko": "나도 이런 수를 둘 수 있네!",
      "en": "I can make moves like that too!"
    },
    {
      "key": "story_002_lose",
      "ko": "아, 그 한 칸을 놓쳤구나.",
      "en": "Oh, I missed that one space."
    },
    {
      "key": "story_opponent_003",
      "ko": "일병 오준호",
      "en": "Pfc. Oh Jun-ho"
    },
    {
      "key": "story_stage_desc_003",
      "ko": "오준호와의 부대 대국. 한 수씩 서로의 기풍을 읽는다.",
      "en": "A friendly match with Oh Jun-ho. Learn each other's style."
    },
    {
      "key": "story_003_intro",
      "ko": "소문은 들었어. 직접 확인해 보자!",
      "en": "I heard the rumors. Let me see for myself!"
    },
    {
      "key": "story_003_win",
      "ko": "오늘 얘깃거리는 내가 만들었네!",
      "en": "Now I have a story to tell!"
    },
    {
      "key": "story_003_lose",
      "ko": "소문보다 잘하네. 인정!",
      "en": "Better than the rumors. Respect!"
    },
    {
      "key": "story_opponent_004",
      "ko": "상병 정한결",
      "en": "Cpl. Jung Han-gyeol"
    },
    {
      "key": "story_stage_desc_004",
      "ko": "정한결와의 부대 대국. 한 수씩 서로의 기풍을 읽는다.",
      "en": "A friendly match with Jung Han-gyeol. Learn each other's style."
    },
    {
      "key": "story_004_intro",
      "ko": "네 수를 보고 왔어. 이번엔 읽어 볼게.",
      "en": "I studied your moves. This time I can read you."
    },
    {
      "key": "story_004_win",
      "ko": "준비한 수가 통했어.",
      "en": "My preparation paid off."
    },
    {
      "key": "story_004_lose",
      "ko": "그 수는 기록해 둬야겠네.",
      "en": "I need to write that move down."
    },
    {
      "key": "story_opponent_005",
      "ko": "병장 남기석",
      "en": "Sgt. Nam Gi-seok"
    },
    {
      "key": "story_stage_desc_005",
      "ko": "남기석와의 부대 대국. 한 수씩 서로의 기풍을 읽는다.",
      "en": "A friendly match with Nam Gi-seok. Learn each other's style."
    },
    {
      "key": "story_005_intro",
      "ko": "편하게 둬. 나도 편하게 이겨 볼게.",
      "en": "Relax. I plan to win at my own pace."
    },
    {
      "key": "story_005_win",
      "ko": "느긋해 보여도 판은 보고 있지.",
      "en": "I may look relaxed, but I watch the board."
    },
    {
      "key": "story_005_lose",
      "ko": "오, 잠이 확 깨는 수였어.",
      "en": "Now that move woke me up!"
    },
    {
      "key": "story_opponent_006",
      "ko": "하사 최건우",
      "en": "Staff Sgt. Choi Geon-woo"
    },
    {
      "key": "story_stage_desc_006",
      "ko": "최건우와의 부대 대국. 한 수씩 서로의 기풍을 읽는다.",
