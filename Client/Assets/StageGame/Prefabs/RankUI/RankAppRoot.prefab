    - target: {fileID: 275093836743160596, guid: 8e267d69d2a6b974e92fac193dee379d, type: 3}
      propertyPath: m_Text
      value: "1. \uC5F4\uC744 \uACE8\uB77C \uB193\uC77C \uC790\uB9AC\uB97C \uD655\uC778\uD574\uC694.\n\n2.
        '\uB193\uAE30'\uB97C \uB204\uB974\uBA74 \uAC00\uC7A5 \uC544\uB798 \uBE48\uCE78\uC5D0
        \uB3CC\uC774 \uB193\uC5EC\uC694.\n\n3. \uAC00\uB85C\xB7\uC138\uB85C\xB7\uB300\uAC01\uC120\uC73C\uB85C
        \uB124 \uB3CC\uC744 \uBA3C\uC800 \uC774\uC73C\uBA74 \uC2B9\uB9AC\uD574\uC694.\n\n\uB098\uB294
