    - target: {fileID: 9178218842725229684, guid: 56a2cee4847dad144a78e7157c6dc301, type: 3}
      propertyPath: m_Text
      value: "1. \uC5F4\uC744 \uB204\uB974\uBA74 \uAC00\uC7A5 \uC544\uB798\uC5D0
