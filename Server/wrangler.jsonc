{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stagegame-purchase-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:8080,http://127.0.0.1:8080"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stagegame-purchases-dev",
      "database_id": "local-only-not-a-remote-database",
      "migrations_dir": "migrations"
    }
  ]
}
