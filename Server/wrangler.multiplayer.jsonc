{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "permission-to-win-multiplayer-dev",
  "main": "src/multiplayer/worker.ts",
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "MULTIPLAYER_ENABLED": "true", "ALLOWED_ORIGINS": "http://localhost:8080,http://127.0.0.1:8080" },
  "durable_objects": { "bindings": [{ "name": "ARENA", "class_name": "MultiplayerArena" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MultiplayerArena"] }]
}
