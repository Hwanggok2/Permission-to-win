* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.cs text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.html text eol=lf
*.asmdef text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.unity text eol=lf whitespace=-blank-at-eol
*.prefab text eol=lf whitespace=-blank-at-eol
*.asset text eol=lf whitespace=-blank-at-eol
*.meta text eol=lf whitespace=-blank-at-eol
*.xlsx binary
*.png binary
*.jpg binary
*.otf binary
*.wav binary
# Preserve byte hashes of evidence and third-party legal originals.
Client/Evidence/** -text whitespace=cr-at-eol,-blank-at-eol
Docs/QA/Evidence/** -text whitespace=cr-at-eol,-blank-at-eol
Docs/Management/Evidence/** -text whitespace=cr-at-eol,-blank-at-eol
GameData/Validation/** -text whitespace=cr-at-eol,-blank-at-eol
Client/Assets/StreamingAssets/Notices/** -text whitespace=-blank-at-eol
Client/Assets/StageGame/Resources/LegalNotices.txt -text whitespace=-blank-at-eol
Licence/ThirdParty/** -text whitespace=-blank-at-eol
