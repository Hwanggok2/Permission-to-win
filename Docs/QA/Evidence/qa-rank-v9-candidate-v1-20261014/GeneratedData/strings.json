  "strings": [
    {
      "key": "ad_test_mode",
      "ko": "광고 테스트 모드",
      "en": "Ad test mode"
    },
    {
      "key": "ad_unavailable",
      "ko": "광고를 준비하지 못했어요.",
      "en": "No ad available."
    },
    {
      "key": "ai_rank_01_intro",
      "ko": "프로라며? 나도 한 판 붙어볼래.",
      "en": "So you're a pro? Let me try a round."
    },
    {
      "key": "ai_rank_01_lose",
      "ko": "소문이 진짜였네. 다음엔 내가 이긴다.",
      "en": "The rumors were true. Next time, I'll win."
    },
    {
      "key": "ai_rank_01_win",
      "ko": "나도 프로 해도 되겠는데?",
      "en": "Maybe I should go pro too!"
    },
    {
      "key": "ai_rank_02_intro",
      "ko": "프로가 왔다며? 소문 한번 확인해볼까?",
      "en": "A pro joined us? Let's test those rumors."
    },
    {
      "key": "ai_rank_02_lose",
      "ko": "소문날 만하네. 다음 판은 내 거야.",
      "en": "Those rumors make sense. Next round is mine."
    },
    {
      "key": "ai_rank_02_win",
      "ko": "소문보다 내가 더 센 것 같은데?",
      "en": "Looks like I beat the rumors."
    },
    {
      "key": "ai_rank_03_intro",
      "ko": "프로도 빈틈은 있겠지? 내가 찾아볼게.",
      "en": "Even pros leave openings. I'll find yours."
    },
    {
      "key": "ai_rank_03_lose",
      "ko": "빈틈이 없네. 다음엔 꼭 찾아낸다.",
      "en": "No opening this time. I'll find one next round."
    },
    {
      "key": "ai_rank_03_win",
      "ko": "찾았다, 프로의 빈틈!",
      "en": "Found it: a pro's weak spot!"
    },
    {
      "key": "ai_rank_04_intro",
      "ko": "프로의 전략, 내 수랑 겨뤄볼까?",
      "en": "Let's see your strategy against mine."
    },
    {
      "key": "ai_rank_04_lose",
      "ko": "전략 좋네. 다음엔 내가 읽어낸다.",
      "en": "Good strategy. Next time, I'll read your moves."
    },
    {
      "key": "ai_rank_04_win",
      "ko": "이번 작전은 내가 한 수 위였네.",
      "en": "My plan was one move ahead."
    },
    {
      "key": "ai_rank_05_intro",
      "ko": "여기서 내가 제일 센데, 프로는 다를까?",
      "en": "I'm the best here. Can a pro change that?"
    },
    {
      "key": "ai_rank_05_lose",
      "ko": "강자 자리 내줬네. 다음엔 되찾는다.",
      "en": "You took my top spot. I'll win it back."
    },
    {
      "key": "ai_rank_05_win",
      "ko": "우리 부대 강자는 아직 나네!",
      "en": "I'm still the one to beat around here!"
    },
    {
      "key": "ai_rank_06_intro",
      "ko": "프로라고 서두를 건 없지. 한 판 해볼까?",
      "en": "No rush, pro. Shall we play a round?"
    },
    {
      "key": "ai_rank_06_lose",
      "ko": "침착하네. 다음엔 내가 먼저 잇겠어.",
      "en": "Cool under pressure. I'll connect first next time."
    },
    {
      "key": "ai_rank_06_win",
      "ko": "차분하게 두니 프로도 잡히네.",
      "en": "A steady game can beat a pro too."
    },
    {
      "key": "ai_rank_07_intro",
      "ko": "몇 수 앞까지 봐? 나랑 한번 겨뤄보자.",
      "en": "How many moves ahead can you see? Let's play."
    },
    {
      "key": "ai_rank_07_lose",
      "ko": "더 멀리 봤군. 다음엔 내가 앞서간다.",
      "en": "You saw further. I'll get ahead next time."
    },
    {
      "key": "ai_rank_07_win",
      "ko": "프로보다 한 수 더 봤나 보네.",
      "en": "Looks like I saw one move further."
    },
    {
      "key": "ai_rank_08_intro",
      "ko": "오래 둔 경험도 만만치 않아. 붙어볼까?",
      "en": "Years of play count for something. Ready?"
    },
    {
      "key": "ai_rank_08_lose",
      "ko": "경험만으론 안 되네. 다음엔 다를 거야.",
      "en": "Experience wasn't enough. Next time will be different."
    },
    {
      "key": "ai_rank_08_win",
      "ko": "이런 판은 경험이 답이지.",
      "en": "Experience wins this kind of game."
    },
    {
      "key": "ai_rank_09_intro",
      "ko": "나도 프로에게 도전할 차례지?",
      "en": "My turn to challenge the pro, right?"
    },
    {
      "key": "ai_rank_09_lose",
      "ko": "도전할 맛 나네. 다음엔 내가 이긴다.",
      "en": "Now that's a challenge. Next time, I'll win."
    },
    {
      "key": "ai_rank_09_win",
      "ko": "도전하길 잘했네. 프로를 이겼어!",
      "en": "Glad I challenged you. I beat the pro!"
    },
    {
      "key": "ai_rank_10_intro",
      "ko": "마지막 도전자야. 프로 실력 보여줘.",
      "en": "I'm your final challenger. Show me your pro skills."
    },
    {
      "key": "ai_rank_10_lose",
      "ko": "프로답네. 다음 승부는 내가 가져간다.",
      "en": "A true pro. Next time, the win is mine."
    },
    {
      "key": "ai_rank_10_win",
      "ko": "마지막 승부는 내 거네. 다시 붙을까?",
      "en": "The final round is mine. Want a rematch?"
    },
